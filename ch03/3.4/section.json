     "starter": "class MinStack:\n    def __init__(self):\n        pass\n\n    def push(self, x):\n        pass\n\n    def pop(self):\n        pass\n\n    def size(self):\n        pass\n\n    def min(self):\n        pass\n\n\ndef run(ops):\n    # Plays the operations on a new MinStack and returns what pop, size and min return, in order. Leave it as it is.\n    s = MinStack()\n    out = []\n    for name, *args in ops:\n        r = getattr(s, name)(*args)\n        if name != \"push\":\n            out.append(r)\n    return out\n",
     "reference": "class MinStack:\n    def __init__(self):\n        self.st = []\n\n    def push(self, x):\n        new_min = x if not self.st else min(x, self.st[-1][1])\n        self.st.append((x, new_min))\n\n    def pop(self):\n        return self.st.pop()[0]\n\n    def size(self):\n        return len(self.st)\n\n    def min(self):\n        return self.st[-1][1]\n\n\ndef run(ops):\n    # Plays the operations on a new MinStack and returns what pop, size and min return, in order. Leave it as it is.\n    s = MinStack()\n    out = []\n    for name, *args in ops:\n        r = getattr(s, name)(*args)\n        if name != \"push\":\n            out.append(r)\n    return out\n",
     "generated_by": "ai"
