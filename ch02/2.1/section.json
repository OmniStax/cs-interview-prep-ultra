     "entry": "run",
     "starter": "class ArrayList {\n  constructor() {\n  }\n\n  size() {\n  }\n\n  get(i) {\n  }\n\n  set(i, x) {\n  }\n\n  add(i, x) {\n  }\n\n  remove(i) {\n  }\n}\n\nfunction run(ops) {\n  const list = new ArrayList();\n  const out = [];\n  for (const [name, ...args] of ops) {\n    const value = list[name](...args);\n    if (name === \"get\" || name === \"size\") out.push(value);\n  }\n  return out;\n}\n",
