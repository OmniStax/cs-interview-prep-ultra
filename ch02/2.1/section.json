    "python": {
     "entry": "run",
     "starter": "class ArrayList:\n    def __init__(self):\n        pass\n\n    def size(self):\n        pass\n\n    def get(self, i):\n        pass\n\n    def set(self, i, x):\n        pass\n\n    def add(self, i, x):\n        pass\n\n    def remove(self, i):\n        pass\n\n\ndef run(ops):\n    lst, out = ArrayList(), []\n    for name, *args in ops:\n        value = getattr(lst, name)(*args)\n        if name in (\"get\", \"size\"):\n            out.append(value)\n    return out\n",
     "reference": "class ArrayList:\n    def __init__(self):\n        self.a = [None]\n        self.n = 0\n\n    def size(self):\n        return self.n\n\n    def get(self, i):\n        return self.a[i]\n\n    def set(self, i, x):\n        y = self.a[i]\n        self.a[i] = x\n        return y\n\n    def add(self, i, x):\n        if self.n == len(self.a):\n            self.a = self.a + [None] * len(self.a)\n        for j in range(self.n, i, -1):\n            self.a[j] = self.a[j - 1]\n        self.a[i] = x\n        self.n += 1\n\n    def remove(self, i):\n        x = self.a[i]\n        for j in range(i, self.n - 1):\n            self.a[j] = self.a[j + 1]\n        self.n -= 1\n        self.a[self.n] = None\n        return x\n\n\ndef run(ops):\n    lst, out = ArrayList(), []\n    for name, *args in ops:\n        value = getattr(lst, name)(*args)\n        if name in (\"get\", \"size\"):\n            out.append(value)\n    return out\n",
